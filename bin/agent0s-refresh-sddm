#!/bin/bash

# agent0s:summary=Refresh the SDDM theme from default
# agent0s:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves an untrusted source or
# follows a destination symlink while restoring the packaged SDDM theme.
exec "$AGENT0S_PATH/bin/agent0s-plymouth-set" --refresh-sddm-default
