#!/bin/bash

# agent0s:summary=Remove Grok Bot along with its settings and data.
# agent0s:requires-sudo=true

set -e

agent0s-pkg-drop grok-bot

# Not ~/.grok: that is the Grok CLI, which is installed and used on its own.
rm -rf \
  "$HOME/.config/Grok Bot" \
  "$HOME/.grokbot"

echo ""
echo "Grok Bot has been removed."
