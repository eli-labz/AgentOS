#!/bin/bash

# agent0s:summary=Print the active Agent0S package channel

set -euo pipefail

# Dev is a linked source checkout: AGENT0S_PATH points somewhere other than
# the package-backed install at /usr/share/agent0s. This takes precedence over
# the package channels, since the checkout overrides whatever is installed.
if [[ $AGENT0S_PATH != "/usr/share/agent0s" ]]; then
  echo dev
  exit 0
fi

# agent0s-dev / agent0s-settings-dev are only shipped from the edge package
# repo, so their presence alone means edge. agent0s / agent0s-settings come
# from either the stable or rc mirror, distinguished by agent0s-version-channel
# (which reports the mirror as its first token).
if pacman -Q agent0s-dev agent0s-settings-dev >/dev/null 2>&1; then
  echo edge
elif pacman -Q agent0s agent0s-settings >/dev/null 2>&1; then
  channel=$(agent0s-version-channel 2>/dev/null | awk '{ print $1 }')
  case "$channel" in
    stable) echo stable ;;
    rc) echo rc ;;
    *) echo unknown ;;
  esac
else
  echo unknown
fi
