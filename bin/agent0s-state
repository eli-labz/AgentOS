#!/bin/bash

# agent0s:summary=Manage persistent state files for Agent0S toggles and settings.
# agent0s:args=<set|clear> <state-name-or-pattern>
# agent0s:hidden=true

STATE_DIR="$HOME/.local/state/agent0s"
mkdir -p "$STATE_DIR"

COMMAND="$1"
STATE_NAME="$2"

if [[ -z $COMMAND ]]; then
  echo "Usage: agent0s-state <set|clear> <state-name-or-pattern>"
  exit 1
fi

if [[ -z $STATE_NAME ]]; then
  echo "Usage: agent0s-state $COMMAND <state-name>"
  exit 1
fi

case "$COMMAND" in
set) touch "$STATE_DIR/$STATE_NAME" ;;
clear) find "$STATE_DIR" -maxdepth 1 -type f -name "$STATE_NAME" -delete ;;
esac
