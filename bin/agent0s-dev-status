#!/bin/bash

# agent0s:summary=Show the current Agent0S dev-link state
# agent0s:group=dev

set -euo pipefail

default_target="/usr/share/agent0s"
sudoers_file="/etc/sudoers.d/agent0s-dev-path"
configured="$default_target"
conf_present=0
linked=0

if [[ -f /etc/agent0s.conf ]]; then
  conf_present=1
  configured=$(
    AGENT0S_PATH=
    # shellcheck disable=SC1091
    . /etc/agent0s.conf
    printf '%s' "${AGENT0S_PATH:-<empty>}"
  )
  if [[ $configured != "$default_target" ]]; then
    linked=1
  fi
fi

# /etc/sudoers.d is root-only, so report what sudo resolves rather than reading
# the drop-in — and say so plainly instead of guessing when there is no cached
# credential to ask with. A missing entry here is what makes `sudo agent0s-*`
# run the packaged copy of a command the checkout has changed.
sudo_bin_dir() {
  local resolved

  if ! sudo -n true 2>/dev/null; then
    echo "unknown (needs sudo)"
    return
  fi

  resolved=$(sudo -n bash -c 'type -P agent0s-dev-status' 2>/dev/null) || {
    echo "not on sudo's PATH"
    return
  }

  dirname "$resolved"
}

if (( linked )); then
  echo "dev-link: configured"
  echo "  /etc/agent0s.conf -> AGENT0S_PATH=$configured"
  echo "  sudo resolves agent0s-* from: $(sudo_bin_dir)"
  echo "  status: reboot required before all session layers use this checkout"
else
  echo "dev-link: inactive"
  if (( conf_present )); then
    echo "  /etc/agent0s.conf -> AGENT0S_PATH=$configured (default guard)"
  fi
fi

echo "  current shell:       AGENT0S_PATH=${AGENT0S_PATH:-<unset>}"

if [[ ${AGENT0S_PATH:-$default_target} != "$configured" ]]; then
  echo
  echo "Note: the running session does not match /etc/agent0s.conf. Reboot to settle it."
fi
