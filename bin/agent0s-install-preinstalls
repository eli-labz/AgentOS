#!/bin/bash

# agent0s:summary=Restore the preinstalled Agent0S applications (web apps, TUIs, and selected packages).
# agent0s:requires-sudo=true

if gum confirm "Are you sure you want to restore all preinstalled web apps, TUI wrappers, and desktop applications?"; then
  echo -e "Restoring preinstalled Agent0S applications...\n"

  # Recreates the shipped .desktop launchers (web apps and TUIs) and the mise stubs
  # that back claude, gh, opencode, and the rest of the agents
  agent0s-refresh-applications

  # Mirrors the list in agent0s-remove-preinstalls; both track agent0s-base.packages
  if ! agent0s-pkg-add \
    aether \
    cliamp \
    libreoffice-fresh \
    xournalpp \
    pinta \
    obsidian \
    obs-studio \
    kdenlive \
    moonlight-qt \
    lazydocker \
    omacut \
    omacalc \
    omawrite; then
    echo -e "\nPreinstalls are still marked as removed. Fix the errors above and try again."
    exit 1
  fi

  # Last, so a failure above leaves the opt-out intact rather than restoring
  # keybindings for apps that never came back
  rm -f ~/.local/state/agent0s/preinstalls-removed
  hyprctl reload
fi
