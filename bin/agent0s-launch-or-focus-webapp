#!/bin/bash

# agent0s:summary=Launch or focus on a given web app identified by the window-pattern.
# agent0s:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: agent0s-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="agent0s-launch-webapp $@"

exec agent0s-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
