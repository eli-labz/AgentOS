#!/bin/bash

# agent0s:summary=Install a Nerd Font package and switch the system to it
# agent0s:args=<display-name> <package> <family>
# agent0s:examples=agent0s install font 'Cascadia Mono' ttf-cascadia-mono-nerd 'CaskaydiaMono Nerd Font'

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: agent0s-install-font <display-name> <package> <family>" >&2
  exit 1
fi

printf -v install_message '%q' "Installing ${name}..."
printf -v package_arg '%q' "$package"
printf -v family_arg '%q' "$family"

exec agent0s-launch-floating-terminal-with-presentation \
  "echo ${install_message}; agent0s-pkg-add ${package_arg} && sleep 2 && agent0s-font-set ${family_arg}"
