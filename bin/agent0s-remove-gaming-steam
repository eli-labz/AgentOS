#!/bin/bash

# agent0s:summary=Remove Steam and all of its game libraries, configs, and caches.
# agent0s:requires-sudo=true

set -e

agent0s-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
