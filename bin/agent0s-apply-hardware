#!/bin/bash

# agent0s:summary=Apply Agent0S hardware-specific packages and system configuration
# agent0s:group=apply
# agent0s:requires-sudo=true
# agent0s:examples=agent0s apply hardware --install-user dhh
# agent0s:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: agent0s apply hardware --install-user USER
       agent0s apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by agent0s-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/agent0s/provisioning/groups.
USAGE
}

install_user="${AGENT0S_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: agent0s-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export AGENT0S_INSTALL_USER="$install_user"
export AGENT0S_PATH="${AGENT0S_PATH:-/usr/share/agent0s}"
export AGENT0S_INSTALL="${AGENT0S_INSTALL:-$AGENT0S_PATH/install}"
export AGENT0S_INSTALL_LOG_FILE="${AGENT0S_INSTALL_LOG_FILE:-/var/log/agent0s-install.log}"
export PATH="$AGENT0S_PATH/bin:$PATH"

source "$AGENT0S_INSTALL/helpers/logging.sh"
source "$AGENT0S_INSTALL/hardware/all.sh"
