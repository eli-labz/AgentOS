#!/bin/bash

# agent0s:summary=Update the active Agent0S dev checkout

set -euo pipefail

[[ $AGENT0S_PATH != "/usr/share/agent0s" ]] || exit 0

if ! git -C "$AGENT0S_PATH" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Error: AGENT0S_PATH is not a git checkout: $AGENT0S_PATH" >&2
  exit 1
fi

upstream=$(git -C "$AGENT0S_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [[ -z $upstream ]]; then
  echo -e "\e[33m\nSkip Agent0S dev checkout update (current branch has no upstream)\e[0m"
  exit 0
fi

echo -e "\e[32m\nUpdate Agent0S dev checkout\e[0m"
git -C "$AGENT0S_PATH" pull --ff-only
