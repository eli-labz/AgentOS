#!/bin/bash

# agent0s:summary=Edit, set, or reset About branding
# agent0s:group=branding
# agent0s:name=about
# agent0s:args=<image|text|reset>
# agent0s:examples=agent0s branding about image | agent0s branding about text | agent0s branding about reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(agent0s-file-select --title "Pick PNG or SVG for About" --extensions "png svg")
  if agent0s-transcode-ascii "$image" ~/.config/agent0s/branding/about.txt --width 54 --height 26; then
    agent0s-launch-about >/dev/null 2>&1
  fi
  ;;
text)
  agent0s-launch-editor ~/.config/agent0s/branding/about.txt >/dev/null 2>&1 && agent0s-launch-about >/dev/null 2>&1
  ;;
reset)
  cp "$AGENT0S_PATH/icon.txt" ~/.config/agent0s/branding/about.txt && agent0s-launch-about >/dev/null 2>&1
  ;;
*)
  echo "Usage: agent0s-branding-about <image|text|reset>" >&2
  exit 1
  ;;
esac
