#!/bin/bash

# agent0s:summary=List themes that can style the Plymouth boot screen
# agent0s:examples=agent0s plymouth list

{
  find ~/.config/agent0s/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n' 2>/dev/null
  find "$AGENT0S_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  if [[ -f $(agent0s-theme-dir "$name")/preview-unlock.png ]]; then
    echo "$name"
  fi
done
