#!/bin/bash

# agent0s:summary=Launch a TUI command in the default terminal with Agent0S styling
# agent0s:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
  shift
else
  APP_ID="org.agent0s.$(basename $1)"
fi

exec setsid uwsm-app -- xdg-terminal-exec --app-id=$APP_ID -e "$1" "${@:2}"
