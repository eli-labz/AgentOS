#!/bin/bash

# agent0s:summary=Open the current theme's user background folder

CURRENT_THEME_NAME=$(cat "$HOME/.local/state/agent0s/current/theme.name")
THEME_USER_BACKGROUNDS="$HOME/.config/agent0s/backgrounds/$CURRENT_THEME_NAME"

mkdir -p "$THEME_USER_BACKGROUNDS"
nautilus "$THEME_USER_BACKGROUNDS"
