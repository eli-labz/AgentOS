#!/bin/bash

# agent0s:summary=Reinstall Agent0S packages and reset default configs
# agent0s:requires-sudo=true

set -e

echo -e "This will reinstall all default Agent0S packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  agent0s-reinstall-pkgs
  agent0s-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && agent0s-system-reboot
fi
