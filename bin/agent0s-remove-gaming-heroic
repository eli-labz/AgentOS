#!/bin/bash

# agent0s:summary=Remove Heroic Games Launcher and its game libraries, configs, and caches.
# agent0s:requires-sudo=true

set -e

agent0s-pkg-drop heroic-games-launcher-bin

rm -rf \
  "$HOME/.config/heroic" \
  "$HOME/.local/share/heroic" \
  "$HOME/.cache/heroic" \
  "$HOME/Games/Heroic"

echo ""
echo "Heroic and its data have been removed."
