#!/bin/bash

# agent0s:summary=Install Steam and graphics drivers selected for this system
# agent0s:requires-sudo=true

set -e

echo "Installing Steam..."
agent0s-pkg-add steam
agent0s-install-gaming-gpu-lib32

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
