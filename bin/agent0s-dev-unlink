#!/bin/bash

# agent0s:summary=Restore Agent0S to the package install after reboot
# agent0s:group=dev
# agent0s:args=[--no-reboot]

set -euo pipefail

if (( EUID == 0 )); then
  echo "Error: run agent0s-dev-unlink as your user, not under sudo." >&2
  exit 1
fi

prompt_reboot=1

sudoers_file="/etc/sudoers.d/agent0s-dev-path"

if (( $# > 1 )); then
  echo "Usage: agent0s dev unlink [--no-reboot]" >&2
  exit 1
fi

case "${1:-}" in
  "")
    ;;
  --no-reboot)
    prompt_reboot=0
    ;;
  -h|--help)
    cat <<USAGE
Usage: agent0s dev unlink [--no-reboot]

Writes /etc/agent0s.conf so AGENT0S_PATH resolves to /usr/share/agent0s
after reboot. This intentionally does not rewrite the running Hyprland,
systemd, shell, or app-launcher environment; reboot to make every layer agree.

Removes $sudoers_file, the drop-in that pointed sudo
at the checkout, so sudo goes back to the packaged agent0s-* immediately.

Use --no-reboot when another command will handle the reboot prompt.
USAGE
    exit 0
    ;;
  *)
    echo "Usage: agent0s dev unlink [--no-reboot]" >&2
    exit 1
    ;;
esac

default_target="/usr/share/agent0s"

printf 'export AGENT0S_PATH="%s"\n' "$default_target" | sudo tee /etc/agent0s.conf >/dev/null

# agent0s-dev-link prepended the checkout to sudo's secure_path. Drop it in the
# same step that drops the checkout, or sudo keeps running a tree nothing else
# points at — and keeps trusting a user-writable directory for root's commands.
sudo rm -f "$sudoers_file"

echo "Pointed Agent0S at $default_target"
echo

if (( prompt_reboot )) && gum confirm "Reboot now to activate?"; then
  agent0s-system-reboot
fi
