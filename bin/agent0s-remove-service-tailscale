#!/bin/bash

# agent0s:summary=Remove Tailscale and its bar plugin.
# agent0s:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now agent0s-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
agent0s-plugin-disable agent0s.tailscale
agent0s-webapp-remove "Tailscale" 2>/dev/null || true
agent0s-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
