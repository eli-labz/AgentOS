#!/bin/bash

# agent0s:summary=Log out after closing application windows
# agent0s:examples=agent0s logout | agent0s system logout
# agent0s:aliases=agent0s logout

nohup bash -c "sleep 2 && uwsm stop" >/dev/null 2>&1 &

agent0s-osd -i logout -m "Logging out" -d 5000

# Now close all windows
agent0s-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
