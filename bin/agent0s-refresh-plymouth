#!/bin/bash

# agent0s:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Agent0S default and rebuild it.
# agent0s:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$AGENT0S_PATH/bin/agent0s-plymouth-set" --refresh-default
