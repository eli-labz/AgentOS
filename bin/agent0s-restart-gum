#!/bin/bash

# agent0s:summary=Export the current theme's gum styling into the environment
# agent0s:hidden=true

# Meant to be sourced. gum_env.lua is fed into the compositor environment via
# hl.env at login, but that environment is captured once and is not refreshed on
# a theme switch, so anything launched from the session would otherwise inherit
# the login-time theme's gum colors. Export the current values instead.
_agent0s_gum_env="$HOME/.local/state/agent0s/current/theme/gum_env.lua"

if [[ -f $_agent0s_gum_env ]]; then
  while IFS=$'\t' read -r _agent0s_gum_key _agent0s_gum_value; do
    [[ -n $_agent0s_gum_key && -n $_agent0s_gum_value ]] && export "$_agent0s_gum_key=$_agent0s_gum_value"
  done < <(awk -F'"' '/hl\.env\("[A-Z0-9_]+", "[^"]+"\)/ { print $2 "\t" $4 }' "$_agent0s_gum_env")
fi

unset _agent0s_gum_env _agent0s_gum_key _agent0s_gum_value
