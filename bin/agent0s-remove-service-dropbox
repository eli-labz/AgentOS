#!/bin/bash

# agent0s:summary=Remove Dropbox and its bar plugin.
# agent0s:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
agent0s-plugin-disable agent0s.dropbox
agent0s-pkg-drop dropbox dropbox-cli libappindicator-gtk3 python-gpgme nautilus-dropbox

echo ""
echo "Dropbox has been removed."
