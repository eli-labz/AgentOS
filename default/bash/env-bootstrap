# Single source of truth for AGENT0S_PATH + PATH adjustments. Sourced by:
#   /etc/profile.d/agent0s.sh                 (system login shells)
#   /etc/skel/.bashrc                         (interactive shells)
#   /usr/share/uwsm/env.d/10-agent0s          (Hyprland session via uwsm)
#   /usr/share/agent0s/default/bash/envs      (bash rc chain; SSH/non-login)

# /etc/agent0s.conf is written by agent0s-dev-link and reset by
# agent0s-dev-unlink. When absent, force the packaged default instead of
# preserving a stale inherited value.
if [ -f /etc/agent0s.conf ]; then
  . /etc/agent0s.conf
  : "${AGENT0S_PATH:=/usr/share/agent0s}"
else
  AGENT0S_PATH=/usr/share/agent0s
fi
export AGENT0S_PATH

# Only prepend in dev-link mode. On a production install, the binaries are
# already on PATH as /usr/bin/agent0s-* via the agent0s package — prepending
# /usr/share/agent0s/bin would just be noise.
if [ "$AGENT0S_PATH" != /usr/share/agent0s ]; then
  case ":$PATH:" in
    *":${AGENT0S_PATH%/}/bin:"*) ;;
    *) PATH="${AGENT0S_PATH%/}/bin${PATH:+:$PATH}" ;;
  esac
fi

# User-level tool paths, appended so system binaries keep precedence. This is
# what lets login shells (ssh, bash -lc) and the uwsm session find mise-managed
# tools without an interactive rc. Keep these directories in sync with the PAM
# PATH line from install/config/ssh-command-path.sh, which covers SSH commands
# that run no shell setup at all.
case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/share/mise/shims" ;;
esac
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="${PATH:+$PATH:}$HOME/.local/bin" ;;
esac
export PATH
