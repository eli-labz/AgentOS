#!/bin/bash

set -e

# Agent0S ships no default agent, so invite once rather than picking one. An
# agent already chosen means the invitation has nothing to offer.
if [[ -z $(agent0s-default-agent) ]] && agent0s-done ensure agent-setup-invitation; then
  agent0s-notification-send -u critical -g 󰚩 "Set your default agent" \
    "Let your favorite agent help with Agent0S." \
    --exec agent0s menu summon setup.default.agent
fi
