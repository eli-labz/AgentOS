{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "agent0s.clock",
    "layout": {
      "left": [
        {
          "id": "agent0s.menu"
        },
        {
          "id": "agent0s.workspaces"
        }
      ],
      "center": [
        {
          "id": "agent0s.indicators"
        },
        {
          "id": "agent0s.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
