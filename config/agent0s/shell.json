        {
          "id": "agent0s.keyboard-layout"
        },
        {
          "id": "agent0s.weather"
        },
        {
          "id": "agent0s.system-update"
        }
      ],
      "right": [
        {
          "id": "agent0s.tray"
        },
        {
          "id": "agent0s.agents"
        },
        {
          "id": "agent0s.bluetooth"
        },
        {
          "id": "agent0s.network"
        },
        {
          "id": "agent0s.audio"
        },
        {
          "id": "agent0s.monitor"
        },
        {
          "id": "agent0s.power"
        }
      ]
    }
